<odoo>
    <template id="cleanmart_kiosk_app" name="Cleanmart Kiosk App">
        <t t-if="props.loading">
            <div class="o_cleanmart_kiosk_loader">Cargando...</div>
        </t>
        <t t-elif="props.loadError">
            <div class="o_cleanmart_kiosk_error" style="color:red">Error al cargar datos. Intenta recargar la página.</div>
        </t>
        <t t-else="">
            <div t-if="props.step == 'select_employee'">
                <h2>Selecciona un empleado</h2>
                <ul>
                    <t t-foreach="props.employees" t-as="emp">
                        <li>
                            <button type="button" t-on-click="() => selectEmployee(emp)"><t t-esc="emp.display_name"/></button>
                        </li>
                    </t>
                </ul>
            </div>
            <div t-if="props.step == 'enter_pin'">
                <h2>Introduce tu PIN</h2>
                <input type="password" t-model="props.pin"/>
                <button type="button" t-on-click="checkPin">Validar</button>
                <div t-if="props.error" style="color:red"><t t-esc="props.error"/></div>
            </div>
            <div t-if="props.step == 'success'">
                <h2><t t-esc="props.attendanceMessage or '¡Asistencia registrada!'"/></h2>
            </div>
        </t>
    </template>
    <template id="kiosk_page" name="Kiosko Asistencias Cleanmart">
        <div id="o_cleanmart_assistance_kiosk_mode"/>
    </template>
</odoo>
