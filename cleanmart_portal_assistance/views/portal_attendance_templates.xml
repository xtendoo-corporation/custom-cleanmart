<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Añadir menú en el portal -->
    <template id="portal_my_home_menu_attendance" name="Portal My Home Menu - Attendance"
        inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True" />
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/hr_attendance/static/description/icon.png'" />
                <t t-set="title">Mi Asistencia</t>
                <t t-set="url" t-value="'/my/attendance'" />
                <t t-set="text">Gestiona tu asistencia diaria</t>
                <t t-set="placeholder_count" t-value="'attendance'" />
            </t>
        </div>
    </template>


    <!-- Página principal de asistencias -->
    <template id="portal_my_attendance" name="My Attendance">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mi Asistencia</t>
            </t>

            <div class="container mt-4 o_portal_attendance_page">
                <div class="row">
                    <!-- Tarjeta principal de Check In/Out -->
                    <div class="col-lg-6 mb-4">
                        <div class="card shadow-sm o_attendance_card">
                            <div class="card-body text-center p-5">
                                <h3 class="mb-4">Estado Actual</h3>

                                <!-- Avatar del empleado -->
                                <div class="o_attendance_avatar mb-4">
                                    <img t-att-src="image_data_uri(employee.image_256)"
                                        class="rounded-circle"
                                        style="width: 120px; height: 120px; object-fit: cover;"
                                        t-att-alt="employee.name" />
                                </div>

                                <h4 class="mb-3" t-esc="employee.name" />

                                <!-- Estado de asistencia -->
                                <div class="o_attendance_status mb-4">
                                    <t t-if="attendance_state == 'checked_in'">
                                        <div class="badge badge-success badge-lg p-3">
                                            <i class="fa fa-check-circle" /> Trabajando </div>
                                        <div class="mt-3">
                                            <small class="text-muted">Check In:</small>
                                            <div class="h5"
                                                t-esc="last_check_in.strftime('%H:%M:%S') if last_check_in else '-'" />
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="badge badge-secondary badge-lg p-3">
                                            <i class="fa fa-sign-out" /> Fuera de servicio </div>
                                        <div class="mt-3">
                                            <small class="text-muted">Último Check Out:</small>
                                            <div class="h5"
                                                t-esc="last_check_out.strftime('%H:%M:%S') if last_check_out else '-'" />
                                        </div>
                                    </t>
                                </div>

                                <!-- Botón de acción -->
                                <button type="button"
                                    class="btn btn-lg o_attendance_action_btn"
                                    t-attf-class="btn btn-lg #{attendance_state == 'checked_in' and 'btn-danger' or 'btn-success'}"
                                    id="attendanceActionBtn">
                                    <t t-if="attendance_state == 'checked_in'">
                                        <i class="fa fa-sign-out" /> Check Out </t>
                                    <t t-else="">
                                        <i class="fa fa-sign-in" /> Check In </t>
                                </button>

                                <div id="attendanceMessage" class="mt-3"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta de estadísticas -->
                    <div class="col-lg-6 mb-4">
                        <div class="card shadow-sm o_attendance_stats_card">
                            <div class="card-body p-4">
                                <h5 class="card-title mb-4">
                                    <i class="fa fa-chart-line" /> Estadísticas de Hoy </h5>

                                <div class="o_stat_item mb-4">
                                    <div class="o_stat_icon">
                                        <i class="fa fa-clock" />
                                    </div>
                                    <div class="o_stat_content">
                                        <div class="o_stat_label">Horas Totales Hoy</div>
                                        <div class="o_stat_value" id="hoursTodayValue">
                                            <span t-esc="'%.2f' % hours_today" /> h </div>
                                    </div>
                                </div>

                                <div class="o_stat_item mb-4">
                                    <div class="o_stat_icon">
                                        <i class="fa fa-hourglass-half" />
                                    </div>
                                    <div class="o_stat_content">
                                        <div class="o_stat_label">Sesión Actual</div>
                                        <div class="o_stat_value" id="lastAttendanceValue">
                                            <span t-esc="'%.2f' % last_attendance_worked_hours" /> h </div>
                                    </div>
                                </div>

                                <div class="o_stat_item mb-4" t-if="display_overtime">
                                    <div class="o_stat_icon">
                                        <i class="fa fa-plus-circle" />
                                    </div>
                                    <div class="o_stat_content">
                                        <div class="o_stat_label">Horas Extra Acumuladas</div>
                                        <div class="o_stat_value">
                                            <span t-esc="'%.2f' % total_overtime" /> h </div>
                                    </div>
                                </div>

                                <hr />

                                <div class="text-center mt-4">
                                    <a href="/my/attendance/history" class="btn btn-outline-primary">
                                        <i class="fa fa-history" /> Ver Historial Completo </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Página de historial -->
    <template id="portal_attendance_history" name="My Attendance History">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Historial de Asistencias</t>
            </t>

            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-history" /> Mis Asistencias </h5>
                            </div>
                            <div class="card-body">
                                <t t-if="not attendances">
                                    <div class="alert alert-info">
                                        No hay registros de asistencia disponibles.
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="table-responsive">
                                        <table class="table table-hover o_attendance_history_table">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Check In</th>
                                                    <th>Check Out</th>
                                                    <th class="text-right">Horas Trabajadas</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="attendances" t-as="attendance">
                                                    <tr>
                                                        <td>
                                                            <span
                                                                t-esc="attendance.check_in.strftime('%d/%m/%Y')" />
                                                        </td>
                                                        <td>
                                                            <span class="badge badge-success">
                                                                <i class="fa fa-sign-in" />
                                                                <span
                                                                    t-esc="attendance.check_in.strftime('%H:%M:%S')" />
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <t t-if="attendance.check_out">
                                                                <span class="badge badge-danger">
                                                                    <i class="fa fa-sign-out" />
                                                                    <span
                                                                        t-esc="attendance.check_out.strftime('%H:%M:%S')" />
                                                                </span>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="badge badge-warning">En
                                                                    curso</span>
                                                            </t>
                                                        </td>
                                                        <td class="text-right">
                                                            <strong>
                                                                <span
                                                                    t-esc="'%.2f' % attendance.worked_hours" />
                                                                h </strong>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div t-if="pager" class="mt-3">
                                        <t t-call="portal.pager" />
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Template para usuarios sin empleado asociado -->
    <template id="portal_attendance_no_employee" name="No Employee Associated">
        <t t-call="portal.portal_layout">
            <div class="container mt-5">
                <div class="alert alert-warning text-center">
                    <h4><i class="fa fa-exclamation-triangle" /> No tienes un empleado asociado</h4>
                    <p class="mb-0">Por favor, contacta con el administrador para que te asocie un
                        empleado.</p>
                </div>
            </div>
        </t>
    </template>

</odoo>